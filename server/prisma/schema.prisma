generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ADVISOR
  CLIENT
}

enum DocumentType {
  CC
  DNI
  PASSPORT
  OTHER
}

enum BiometricType {
  OCULAR
  FACIAL
  DACTILAR
}

enum BiometricMethod {
  DACTILAR
  FACIAL
  OCULAR
}

model Empresa {
  id          String   @id @default(uuid())
  nombre      String   @unique
  nit         String   @unique
  logoUrl     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@index([nombre])
  @@index([nit])
}

model User {
  id              String          @id @default(uuid())
  email           String          @unique
  password        String?
  name            String
  role            Role            @default(CLIENT)
  address         String?
  phone           String?
  birthDate       DateTime?
  age             Int?
  profilePhotoUrl String?
  documentType    DocumentType?
  documentNumber  String?
  biometricType   BiometricType?  // Only for CLIENT
  biometricMethods String[]        @default([])
  biometricEnrollmentRequired Boolean @default(false)
  biometricEnrollmentCompletedAt DateTime?
  biometricEnrollmentRequestedAt DateTime?
  empresaId       String?
  empresa         Empresa?        @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relación jerárquica: quién creó a este usuario (Admin -> Advisor -> Client)
  createdById String?
  createdBy   User?   @relation("UserCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[]  @relation("UserCreator")

  // Relaciones restantes
  sessions  Session[]
  auditLogs AuditLog[]

  @@index([createdById])
  @@index([empresaId])
  @@index([role, empresaId])
  @@index([role])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  entity    String
  entityId  String
  details   String?
  createdAt DateTime @default(now())

  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
}