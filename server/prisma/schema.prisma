generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ADVISOR
  CLIENT
}

enum DocumentType {
  CC
  DNI
  PASSPORT
  OTHER
}

enum BiometricType {
  OCULAR
  FACIAL
  DACTILAR
}

enum BiometricMethod {
  DACTILAR
  DACTILAR_REGISTRO
  DACTILAR_VERIFICACION
  FACIAL
  OCULAR
}

model Empresa {
  id               String   @id @default(uuid())
  nombre           String   @unique
  nit              String?  @unique
  logoUrl          String?
  description      String?
  emailFromName    String?
  emailFromAddress String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users User[]

  @@index([nombre])
  @@index([nit])
}

model User {
  id              String          @id @default(uuid())
  email           String
  password        String?
  name            String
  role            Role            @default(CLIENT)
  address         String?
  phone           String?
  birthDate       DateTime?
  age             Int?
  profilePhotoUrl String?
  documentType    DocumentType?
  documentNumber  String?
  caseNumber      String?
  processNumber   String?
  formId          String?
  nativeCountry   String?
  sex             String?
  validFrom       String?
  cardExpires     String?
  migratoryStatus String?
  receivedDate    String?
  deadline        String?
  biometricType   BiometricType?  // Only for CLIENT
  biometricMethods String[]        @default([])
  biometricEnrollmentRequired Boolean @default(false)
  biometricEnrollmentCompletedAt DateTime?
  biometricEnrollmentRequestedAt DateTime?
  biometricEnrollmentMaxAttempts Int?
  biometricEnrollmentAttempts    Int             @default(0)
  biometricEnrollmentTokenHash   String?
  empresaId       String?
  empresa         Empresa?        @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  biometricRequestLogs          BiometricRequestLog[] @relation("BiometricRequestClient")
  biometricRequestLogsRequested BiometricRequestLog[] @relation("BiometricRequestAdvisor")

  createdById String?
  createdBy   User?   @relation("UserCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[]  @relation("UserCreator")

  sessions  Session[]
  auditLogs AuditLog[]

  @@index([createdById])
  @@index([empresaId])
  @@index([role, empresaId])
  @@index([empresaId, email])
  @@index([empresaId, documentNumber])
  @@index([role])
}

model BiometricRequestLog {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation("BiometricRequestClient", fields: [userId], references: [id], onDelete: Cascade)
  requestedById      String?
  requestedBy        User?    @relation("BiometricRequestAdvisor", fields: [requestedById], references: [id], onDelete: SetNull)
  biometricMethods   String[] @default([])
  emailStatusCode    Int?
  emailStatusMessage String?
  resendEmailId      String?
  emailSentAt        DateTime @default(now())

  @@index([userId])
  @@index([requestedById])
  @@index([emailSentAt])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  entity    String
  entityId  String
  details   String?
  createdAt DateTime @default(now())

  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
}
